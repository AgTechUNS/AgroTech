# =============================================================================
# AgroTech — Configuración unificada
# Copiar como .env y ajustar según entorno local
# =============================================================================

# ───────── InfluxDB ─────────
INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com/
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=datos_sensores

# ───────── Open-Meteo (API pública, sin key) ─────────
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# ───────── Google Earth Engine (Service Account) ─────────
# Local: copiá tu service_account.json a ~/.agrotech/secrets/ y apuntá la ruta acá
GEE_CREDENTIALS_FILE=
# En producción, setear el contenido completo del JSON en una línea:
GEE_CREDENTIALS_JSON=
# Project ID de GCP (opcional si el JSON ya lo incluye)
GEE_PROJECT_ID=
# Colección satelital (Sentinel-2 por defecto)
GEE_COLLECTION_NAME=COPERNICUS/S2_SR_HARMONIZED

# ───────── PostgreSQL (Relational Repository) ─────────
# Neon: postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/agrotech
DATABASE_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/agrotech
# Activar logs de SQL (true/false)
DATABASE_ECHO=false

# ───────── SendGrid (Email) ─────────
SENDGRID_API_KEY=
SENDGRID_FROM=alertas@agtech.com
SENDGRID_SANDBOX_MODE=true

# ───────── Twilio (SMS) ─────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_PHONE=+5491112345678

# ───────── Contacto por defecto ─────────
ALERT_EMAIL=admin@agtech.com

# ───────── Redis (notificaciones) ─────────
REDIS_URL=redis://localhost:6379

# ───────── MQTT (simulador / ingesta) ─────────
BROKER=localhost
PORT=1883

# ───────── Security (JWT, etc.) ─────────
SECRET_KEY=
DATABASE_URL=

# ───────── SPA — Next.js (agtech-spa/.env.local) ─────────
# Estas van en agtech-spa/.env.local (no acá):
# NEXT_PUBLIC_MOCK_AUTH=true
# BACKEND_URL=
