# Entorno: development | production
ENVIRONMENT=development

# Base de datos (SQLite para dev, PostgreSQL para prod)
DATABASE_URL=sqlite+aiosqlite:///./agtech_auth.db

# JWT
ALGORITHM=HS256
SECRET_KEY=cambia_esta_clave_en_produccion
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# HashiCorp Vault (solo producción — dejar vacío en desarrollo)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_SECRET_PATH=agtech/auth
VAULT_MOUNT_POINT=secret

# Rate limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_RESET=3/minute
RATE_LIMIT_REFRESH=30/minute

# Servicio de notificaciones (opcional)
NOTIFICATION_SERVICE_URL=
