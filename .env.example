# === Open-Meteo (API pública, sin key) ===
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# === Google Earth Engine (Service Account) ===
# Local: copiá tu service_account.json a ~/.agrotech/secrets/ y apuntá la ruta acá
GEE_CREDENTIALS_FILE=
# Project ID de GCP (opcional si el JSON ya lo incluye)
GEE_PROJECT_ID=
# Colección satelital (Sentinel-2 por defecto)
GEE_COLLECTION_NAME=COPERNICUS/S2_SR_HARMONIZED

# === Vercel / CI/CD (alternativa al archivo local) ===
# En producción, setear GEE_CREDENTIALS_JSON con el contenido completo del
# service_account.json como string JSON en una línea (sin usar GEE_CREDENTIALS_FILE)
# GEE_CREDENTIALS_JSON={"type":"service_account","project_id":...}
