# === Open-Meteo (API pública, sin key) ===
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# === Google Earth Engine (Service Account) ===
# Local: copiá tu service_account.json a ~/.agrotech/secrets/ y apuntá la ruta acá
GEE_CREDENTIALS_FILE=
# Project ID de GCP (opcional si el JSON ya lo incluye)
GEE_PROJECT_ID=
# Colección satelital (Sentinel-2 por defecto)
GEE_COLLECTION_NAME=COPERNICUS/S2_SR_HARMONIZED

# === Vercel / CI/CD (alternativa al archivo local) ===
# En producción, setear GEE_CREDENTIALS_JSON con el contenido completo del
# service_account.json como string JSON en una línea (sin usar GEE_CREDENTIALS_FILE)
# GEE_CREDENTIALS_JSON={"type":"service_account","project_id":...}

# ─────────────────────────────────────────────
# CONFIGURACIÓN GENERAL DE auth y security
# ─────────────────────────────────────────────
# Controla comportamiento del sistema:
#   development → habilita /docs, /redoc y endpoints /test/*
#   production  → deshabilita todo lo anterior y exige Vault para SECRET_KEY* NO LO VAMOS A USAR EN PRODUCCIÓN SI NO HAY TIEMPO PARA CONFIGURAR VAULT, ASÍ QUE DEJAMOS EL MISMO COMENTARIO QUE EN DESARROLLO LOCAL 
ENVIRONMENT=development

# ─────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────
# Desarrollo local (SQLite — no requiere instalar nada):
DATABASE_URL=sqlite+aiosqlite:///./agtech_auth.db
#
# Cuando el equipo levante PostgreSQL con Docker, reemplazar por:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agtech_auth

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
# Algoritmo de firma del token. HS256 para desarrollo, RS256 recomendado en producción.
ALGORITHM=HS256

# Clave secreta para firmar los JWT (solo se usa si ALGORITHM=HS256).
# En producción esta clave viene de HashiCorp Vault — no debe estar aquí.
# Para desarrollo: cualquier string largo y aleatorio sirve.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_en_produccion

# Tiempo de vida del access token en minutos (recomendado: 15 en producción)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Tiempo de vida del refresh token en días
REFRESH_TOKEN_EXPIRE_DAYS=7

# Tiempo de vida del token de recuperación de contraseña en minutos
RESET_TOKEN_EXPIRE_MINUTES=30
