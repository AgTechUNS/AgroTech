# ── Entorno ────────────────────────────────────────────────────────────────────
# Valores posibles: development | production
ENVIRONMENT=development

# ── JWT ────────────────────────────────────────────────────────────────────────
# Algoritmo de firma: HS256 (simétrico) o RS256 (asimétrico)
ALGORITHM=HS256

# HS256: clave secreta (mínimo 32 caracteres)
SECRET_KEY=cambia_esta_clave_por_una_segura_minimo_32_chars

# RS256: claves PEM (solo si ALGORITHM=RS256, dejar vacío para HS256)
PRIVATE_KEY=
PUBLIC_KEY=

# ── TTLs de tokens ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# ── Base de datos ──────────────────────────────────────────────────────────────
# Ejemplo SQLite (desarrollo): sqlite+aiosqlite:///./agtech_auth.db
# Ejemplo PostgreSQL:          postgresql+asyncpg://user:pass@localhost/agtech
DATABASE_URL=sqlite+aiosqlite:///./agtech_auth.db

# ── HashiCorp Vault (dejar vacío en desarrollo local) ─────────────────────────
VAULT_ADDR=
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_SECRET_PATH=agtech/auth
VAULT_MOUNT_POINT=secret

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_RESET=3/minute
RATE_LIMIT_REFRESH=30/minute

# ── Servicios externos ─────────────────────────────────────────────────────────
NOTIFICATION_SERVICE_URL=
